# Generator is pluggable. Leave LLM_PROVIDER empty to auto-detect
# from the first vendor key present. No key → extractive answers.

# openai | azure | anthropic | groq | ollama | gemini | mistral | openrouter | together | xai | custom
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Vendor keys (used when LLM_API_KEY is empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (no key). Example:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_HOST=http://127.0.0.1:11434

# OpenTelemetry (OTLP/HTTP). Leave empty to keep traces in-process.
# OTEL_SERVICE_NAME=aether
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
