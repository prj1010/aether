# Copy these names into the Render service → Environment tab.
# Do NOT put real keys in git. render.yaml already declares them as sync: false
# so the Blueprint flow prompts once.

# Required for the desk (set by render.yaml)
# NODE_VERSION=22
# NITRO_PRESET=node-server
# HOST=0.0.0.0
# VITE_AUTH_ENABLED=false
# NODE_ENV=production
# PORT is injected by Render — do not set it.

# Optional. Empty / omitted → embedded PGLite, reseeds Northstar on every boot.
DATABASE_URL=

# Generator. Leave every key empty for extractive answers (no vendor).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Only if you run Ollama somewhere Render can reach.
OLLAMA_HOST=
